<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.stu.mapper.StuClassMapper">

    <resultMap type="StuClass" id="StuClassResult">
        <result property="classId"      column="class_id"      />
        <result property="className"    column="class_name"    />
        <result property="classCode"    column="class_code"    />
        <result property="headTeacher"  column="head_teacher"  />
        <result property="capacity"     column="capacity"      />
        <result property="orderNum"     column="order_num"     />
        <result property="status"       column="status"        />
        <result property="remark"       column="remark"        />
        <result property="createBy"     column="create_by"     />
        <result property="createTime"   column="create_time"   />
        <result property="updateBy"     column="update_by"     />
        <result property="updateTime"   column="update_time"   />
        <result property="studentCount" column="student_count" />
    </resultMap>

    <sql id="selectStuClassVo">
        select class_id, class_name, class_code, head_teacher, capacity, order_num, status, remark,
               create_by, create_time, update_by, update_time
        from stu_class
    </sql>

    <select id="selectStuClassList" parameterType="StuClass" resultMap="StuClassResult">
        select c.class_id, c.class_name, c.class_code, c.head_teacher, c.capacity, c.order_num, c.status, c.remark,
               c.create_by, c.create_time, c.update_by, c.update_time,
               (select count(1) from stu_student s where s.class_id = c.class_id) as student_count
        from stu_class c
        <where>
            <if test="className != null and className != ''"> and c.class_name like concat('%', #{className}, '%')</if>
            <if test="classCode != null and classCode != ''"> and c.class_code like concat('%', #{classCode}, '%')</if>
            <if test="headTeacher != null and headTeacher != ''"> and c.head_teacher like concat('%', #{headTeacher}, '%')</if>
            <if test="status != null and status != ''"> and c.status = #{status}</if>
        </where>
        order by c.order_num, c.class_id
    </select>

    <select id="selectStuClassById" parameterType="Long" resultMap="StuClassResult">
        <include refid="selectStuClassVo"/>
        where class_id = #{classId}
    </select>

    <select id="checkClassNameUnique" parameterType="String" resultMap="StuClassResult">
        <include refid="selectStuClassVo"/>
        where class_name = #{className} limit 1
    </select>

    <insert id="insertStuClass" parameterType="StuClass" useGeneratedKeys="true" keyProperty="classId">
        insert into stu_class
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="className != null and className != ''">class_name,</if>
            <if test="classCode != null">class_code,</if>
            <if test="headTeacher != null">head_teacher,</if>
            <if test="capacity != null">capacity,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="className != null and className != ''">#{className},</if>
            <if test="classCode != null">#{classCode},</if>
            <if test="headTeacher != null">#{headTeacher},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateStuClass" parameterType="StuClass">
        update stu_class
        <trim prefix="SET" suffixOverrides=",">
            <if test="className != null and className != ''">class_name = #{className},</if>
            <if test="classCode != null">class_code = #{classCode},</if>
            <if test="headTeacher != null">head_teacher = #{headTeacher},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where class_id = #{classId}
    </update>

    <delete id="deleteStuClassById" parameterType="Long">
        delete from stu_class where class_id = #{classId}
    </delete>

    <delete id="deleteStuClassByIds" parameterType="String">
        delete from stu_class where class_id in
        <foreach item="classId" collection="array" open="(" separator="," close=")">
            #{classId}
        </foreach>
    </delete>

</mapper>
